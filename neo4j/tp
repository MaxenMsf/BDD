# Afficher la liste des noeuds crées (de chaque type)
MATCH (n) 
RETURN n;

# Calculer le nombre de noeuds crées (de chaque type);
MATCH (n)
RETURN labels(n) AS Type, count(*) AS Nombre;

# Afficher toutes les personnes dont les âges sont supérieurs à 20;
MATCH (p:Personne)
WHERE p.age > 20
RETURN p;

# Afficher les noms de toutes les personnes, triés par ordre croissant selon l’âge;
MATCH (p:Personne)
RETURN p.nom
ORDER BY p.age;

# Afficher le nombre de personnes dont les âges sont supérieurs à 20;
MATCH (p:Personne)
WHERE p.age > 20
RETURN COUNT(p);

# Afficher le nombre de personnes pour chaque âge;
MATCH (p:Personne)
RETURN p.age AS Age, count(*) AS Nombre
ORDER BY Age ASC;

# Afficher l’âge moyen de toutes les personnes;
MATCH (p:Personne)
RETURN AVG(p.age)

